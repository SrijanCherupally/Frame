{
  "name": "frame-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/browser.mjs",
    "desktop": "npm run build && electron .",
    "desktop:start": "electron .",
    "server": "python -m uvicorn backend.app:app --host 127.0.0.1 --port 8000",
    "test:backend": "python -m unittest discover -s tests -p \"test_*.py\" -v",
    "format": "prettier --write frontend/src desktop tests/*.mjs tests/*.js vite.config.js package.json",
    "format:check": "prettier --check frontend/src desktop tests/*.mjs tests/*.js vite.config.js package.json"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "electron": "^44.9.0",
    "prettier": "^3.9.10",
    "vite": "^6.1.0"
  },
  "main": "desktop/main.cjs"
}
